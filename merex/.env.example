# Local Postgres — use Neon dashboard connection string on Vercel (SSL params included there).
# Optional for pooled Neon + Prisma migrate: DIRECT_URL="postgresql://...neon.tech/neondb"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/merex"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/merex"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Admin console: default is path-based on this app, e.g. https://www.merex.in/admin and sign-in at /login/admin (leave empty).
# Set only if you use a dedicated hostname (e.g. admin.merex.in): then /admin on the main site redirects there and ADMIN email login is only allowed on that host.
NEXT_PUBLIC_ADMIN_HOST=""
# Optional: admin user — set both, then `npm run admin:upsert` (safe for prod: one user only) or full `npx prisma db seed` (demo data).
ADMIN_SEED_EMAIL=""
ADMIN_SEED_PASSWORD=""
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
COMMISSION_PERCENT="15"
SESSION_SECRET="replace-with-long-random-string"
TOKEN_ENCRYPTION_KEY=""
CRON_SECRET=""
CPV_PAYOUT_REQUIRE_VERIFIED="1"
FEATURE_STAGE_AWARE_DELIVERABLES="1"
FEATURE_WALLET_LIABILITY_GATES="1"
FEATURE_RAZORPAY_WEBHOOK_VERIFY="1"
INSTAGRAM_CLIENT_ID=""
INSTAGRAM_CLIENT_SECRET=""
INSTAGRAM_REDIRECT_URI=""
# Comma-separated scopes requested on the Instagram OAuth consent screen.
# - instagram_business_basic: identity / profile (handle, account type, follower & media counts via Graph /me)
# - instagram_business_manage_insights: per-media insights (Graph /{media-id}/insights)
INSTAGRAM_SCOPE="instagram_business_basic,instagram_business_manage_insights"
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Merex <no-reply@merex.app>"
