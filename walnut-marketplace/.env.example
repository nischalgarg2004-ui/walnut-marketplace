# Local Postgres — use Neon dashboard connection string on Vercel (SSL params included there).
# Optional for pooled Neon + Prisma migrate: DIRECT_URL="postgresql://...neon.tech/neondb"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/walnut"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
COMMISSION_PERCENT="15"
SESSION_SECRET="replace-with-long-random-string"
TOKEN_ENCRYPTION_KEY=""
CRON_SECRET=""
CPV_PAYOUT_REQUIRE_VERIFIED="1"
INSTAGRAM_CLIENT_ID=""
INSTAGRAM_CLIENT_SECRET=""
INSTAGRAM_REDIRECT_URI=""
# For name + followers_count + media_count via Graph `/me`, use scopes your Meta app supports (e.g. instagram_business_basic).
INSTAGRAM_SCOPE="instagram_business_basic"
RESEND_API_KEY=""
RESEND_FROM_EMAIL="OnGram <no-reply@ongram.app>"
