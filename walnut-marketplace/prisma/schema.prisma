generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CREATOR
  BUSINESS
  ADMIN
}

enum RequirementStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum ApplicationStatus {
  APPLIED
  WAITLISTED
  APPROVED
  REJECTED
  WITHDRAWN
}

enum ContractStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
  DISPUTED
}

enum DeliverableStatus {
  SUBMITTED
  REVISION_REQUESTED
  APPROVED
  REJECTED
  UNDER_REVIEW
  PUBLISHED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

enum InstagramAccountType {
  CREATOR
  BUSINESS
}

enum RequirementDeliverableKind {
  STORY
  REEL
  POST
  MIXED
}

enum ContentSource {
  CREATOR_URL
  INSTAGRAM_MEDIA
  UPLOADED_FILE
}

enum BarterShipmentStatus {
  PENDING
  SHIPPED
  RECEIVED
}

model User {
  id              String            @id @default(cuid())
  email           String            @unique
  passwordHash    String?
  phone           String?
  role            UserRole
  status          String            @default("ACTIVE")
  createdAt       DateTime          @default(now())
  creatorProfile  CreatorProfile?
  businessProfile BusinessProfile?
  notifications   Notification[]
  auditLogs       AuditLog[]
  consentRecords  ConsentRecord[]
}

model CreatorProfile {
  id                            String               @id @default(cuid())
  userId                        String               @unique
  fullName                      String
  bio                           String?
  gender                        String?
  niches                        String[]
  city                          String?
  state                         String?
  instagramHandle               String?
  instagramUserId               String?              @unique
  instagramUsername             String?
  instagramAccountType          InstagramAccountType?
  instagramConnectedAt          DateTime?
  instagramAccessTokenEncrypted String?
  instagramTokenExpiresAt       DateTime?
  followerCount                 Int                  @default(0)
  avgEngagement                 Float                @default(0)
  kycStatus                     String               @default("PENDING")
  user                          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications                  Application[]
  contracts                     Contract[]
}

model BusinessProfile {
  id                 String        @id @default(cuid())
  userId             String        @unique
  legalName          String
  brandName          String
  gstinPlaceholder   String?
  website            String?
  category           String?
  billingEmail       String?
  verificationStatus String        @default("PENDING")
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  requirements       Requirement[]
  contracts          Contract[]
}

model Requirement {
  id                    String                      @id @default(cuid())
  businessId            String
  title                 String
  brief                 String
  platforms             String[]
  contentType           String
  deliverableCount      Int                         @default(1)
  deliverableKind       RequirementDeliverableKind?
  applicationDeadline   DateTime?
  deliveryDueAt         DateTime?
  deliveryDueOffsetDays Int?
  startDate             DateTime?
  endDate               DateTime?
  status                RequirementStatus           @default(DRAFT)
  business              BusinessProfile             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  eligibility           RequirementEligibility?
  compensation          CompensationModel?
  applications          Application[]
  contracts             Contract[]
  createdAt             DateTime                    @default(now())
}

model RequirementEligibility {
  id                String      @id @default(cuid())
  requirementId   String      @unique
  genderAllowed     String[]
  minFollowers      Int         @default(0)
  minEngagementRate Float?
  allowedLocations  String[]
  niches            String[]
  requirement       Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
}

model CompensationModel {
  id                String      @id @default(cuid())
  requirementId   String      @unique
  hasBarter         Boolean     @default(false)
  barterNotes       String?
  fixedFeeAmount    Decimal?    @db.Decimal(12, 2)
  cpvRatePer1000    Decimal?    @db.Decimal(12, 2)
  currency          String      @default("INR")
  requirement       Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
}

model Application {
  id                   String            @id @default(cuid())
  requirementId      String
  creatorId            String
  pitch                String?
  status               ApplicationStatus @default(APPLIED)
  appliedAt            DateTime          @default(now())
  decisionAt           DateTime?
  decisionReason       String?
  termsVersion         String?
  termsAcceptedAt      DateTime?
  barterConsentAt      DateTime?
  barterConsentVersion String?
  requirement          Requirement       @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  creator              CreatorProfile    @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  contract             Contract?
}

model Contract {
  id                  String            @id @default(cuid())
  requirementId       String
  creatorId           String
  businessId          String
  applicationId       String            @unique
  termsSnapshotJson   Json
  status              ContractStatus    @default(PENDING)
  acceptedAt          DateTime?
  closedAt            DateTime?
  cancellationReason  String?
  deliveryEtaAt       DateTime?
  requirement         Requirement       @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  creator             CreatorProfile    @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  business          BusinessProfile   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  application         Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  deliverables        Deliverable[]
  performanceReport   PerformanceReport?
  metricSnapshots     MetricSnapshot[]
  payouts             Payout[]
  barterShipment      BarterShipment?
}

model Deliverable {
  id               String            @id @default(cuid())
  contractId       String
  creatorId        String
  fileUrl          String            @default("")
  fileType         String
  contentSource    ContentSource     @default(UPLOADED_FILE)
  externalUrl      String?
  instagramMediaId String?
  submittedAt      DateTime          @default(now())
  status           DeliverableStatus @default(SUBMITTED)
  feedback         String?
  contract         Contract          @relation(fields: [contractId], references: [id], onDelete: Cascade)
}

model PerformanceReport {
  id          String   @id @default(cuid())
  contractId String   @unique
  creatorId   String
  source      String
  viewsCount  Int      @default(0)
  submittedAt DateTime @default(now())
  verifiedAt  DateTime?
  status      String   @default("PENDING")
  contract    Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
}

model MetricSnapshot {
  id         String   @id @default(cuid())
  contractId String
  capturedAt DateTime @default(now())
  source     String
  views      Int      @default(0)
  rawJson    Json?
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId, capturedAt])
}

model BarterShipment {
  id                String               @id @default(cuid())
  contractId        String               @unique
  status            BarterShipmentStatus @default(PENDING)
  trackingHint      String?
  shippedAt         DateTime?
  receivedAt        DateTime?
  acknowledgedByUserId String?
  contract          Contract             @relation(fields: [contractId], references: [id], onDelete: Cascade)
}

model ConsentRecord {
  id          String   @id @default(cuid())
  userId      String
  kind        String
  entityType  String
  entityId    String
  payloadHash String?
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, entityType, entityId])
}

model Payout {
  id                   String       @id @default(cuid())
  contractId           String
  fixedComponentAmount Decimal?     @db.Decimal(12, 2)
  cpvComponentAmount   Decimal?     @db.Decimal(12, 2)
  grossAmount          Decimal      @db.Decimal(12, 2)
  commissionAmount     Decimal      @db.Decimal(12, 2)
  netAmount            Decimal      @db.Decimal(12, 2)
  payoutProvider       String
  payoutRef            String?
  status               PayoutStatus @default(PENDING)
  releasedAt           DateTime?
  contract             Contract     @relation(fields: [contractId], references: [id], onDelete: Cascade)
  invoice              Invoice?
}

model Invoice {
  id                   String   @id @default(cuid())
  payoutId             String   @unique
  invoiceNo            String   @unique
  gstAmountPlaceholder Decimal? @db.Decimal(12, 2)
  tdsAmountPlaceholder Decimal? @db.Decimal(12, 2)
  issuedAt             DateTime @default(now())
  payout               Payout   @relation(fields: [payoutId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String
  entityType  String
  entityId    String
  action      String
  metadata    Json?
  createdAt   DateTime @default(now())
  actor       User     @relation(fields: [actorUserId], references: [id], onDelete: Cascade)
}

model AdminFlag {
  id              String   @id @default(cuid())
  entityType      String
  entityId        String
  reason          String
  status          String   @default("OPEN")
  assignedAdminId String?
  createdAt       DateTime @default(now())
}
